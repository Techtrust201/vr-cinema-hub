# Copier vers .env (jamais commité).
# Les mêmes clés sont dans Vercel pour https://vr-cinema-hub.vercel.app

VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_URL=https://xxxx.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=

# Le stockage des films n'est plus déclaré ici : c'est l'Edge Function
# `origin-upload-url` qui indique au navigateur où écrire. Une variable de moins
# à synchroniser entre Vercel et Supabase, donc une panne de moins.
#
# Le stockage se configure à deux endroits, avec les mêmes valeurs :
#   - secrets Supabase  : supabase secrets set --project-ref <ref> R2_…
#   - origin/.env       : pour les scripts locaux (migration, sauvegarde)
#
#   R2_ENDPOINT=https://<id_de_compte>.r2.cloudflarestorage.com
#   R2_BUCKET=vr-cinema
#   R2_ACCESS_KEY_ID=
#   R2_SECRET_ACCESS_KEY=

# Sentry — tableau de bord (SPA Vite, SDK @sentry/react, région de.sentry.io).
# Aucune de ces valeurs n'est un secret commité. Laisser le DSN vide désactive l'envoi.
# À renseigner dans Vercel (build) ; VERCEL_ENV et VERCEL_GIT_COMMIT_SHA y sont déjà injectés.
NEXT_PUBLIC_SENTRY_DSN=
# Repli si le DSN n'est posé que sous le nom serveur. Même valeur : un DSN de navigateur est public.
# SENTRY_DSN=
# Upload des source maps pendant `vite build`, puis suppression des .map.
# Sans SENTRY_AUTH_TOKEN, le build réussit et n'émet pas de source maps.
# SENTRY_AUTH_TOKEN=
SENTRY_ORG=tech-trust-agency
SENTRY_PROJECT=vr-cinema-hub
